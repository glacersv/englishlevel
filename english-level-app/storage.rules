rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Audios de listening: públicos para leer
    match /audios/{file} { allow read: if true; allow write: if request.auth != null; }
    // Grabaciones de speaking: solo el propio alumno
    match /recordings/{uid}/{file} { allow read, write: if request.auth != null && request.auth.uid == uid; }
  }
}
